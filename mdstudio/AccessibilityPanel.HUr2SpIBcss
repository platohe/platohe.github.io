.accessibility-overlay{position:fixed;inset:0;background:#00000080;display:flex;align-items:center;justify-content:center;z-index:1000;padding:20px}.accessibility-panel{background:#fff;border-radius:12px;box-shadow:0 20px 40px #00000026;max-width:600px;width:100%;max-height:80vh;overflow:hidden;display:flex;flex-direction:column;user-select:none;-webkit-user-select:none;-moz-user-select:none;-ms-user-select:none}.panel-header{display:flex;justify-content:space-between;align-items:center;padding:24px 24px 16px;border-bottom:1px solid #e0e0e0}.panel-header h2{margin:0;font-size:24px;font-weight:600;color:#333}.close-button{background:none;border:none;font-size:28px;color:#666;cursor:pointer;padding:4px;border-radius:4px;transition:all .2s ease;min-width:36px;min-height:36px;display:flex;align-items:center;justify-content:center}.close-button:hover{background:#f0f0f0;color:#333}.close-button:focus{outline:2px solid #2196F3;outline-offset:2px}.panel-content{flex:1;overflow-y:auto;padding:16px 24px}.settings-section{margin-bottom:32px}.settings-section h3{margin:0 0 16px;font-size:18px;font-weight:600;color:#333;border-bottom:2px solid #2196F3;padding-bottom:8px}.setting-item{margin-bottom:20px}.setting-item label{display:block;font-weight:500;color:#333;margin-bottom:8px;font-size:14px}.setting-item input[type=range]{width:100%;height:6px;border-radius:3px;background:#e0e0e0;outline:none;cursor:pointer}.setting-item input[type=range]::-webkit-slider-thumb{appearance:none;width:20px;height:20px;border-radius:50%;background:#2196f3;cursor:pointer;border:2px solid white;box-shadow:0 2px 4px #0003}.setting-item input[type=range]::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:#2196f3;cursor:pointer;border:2px solid white;box-shadow:0 2px 4px #0003}.setting-description{font-size:12px;color:#666;line-height:1.4;margin-top:4px}.checkbox-label{display:flex!important;align-items:flex-start;gap:12px;cursor:pointer;font-weight:500!important;margin-bottom:8px!important}.checkbox-label input[type=checkbox]{position:absolute;opacity:0;cursor:pointer;height:0;width:0}.checkmark{position:relative;display:inline-block;height:20px;width:20px;background-color:#e0e0e0;border-radius:4px;transition:all .2s ease;flex-shrink:0;margin-top:2px}.checkbox-label:hover input~.checkmark{background-color:#d0d0d0}.checkbox-label input:checked~.checkmark{background-color:#2196f3}.checkmark:after{content:"";position:absolute;display:none;left:7px;top:3px;width:5px;height:10px;border:solid white;border-width:0 2px 2px 0;transform:rotate(45deg)}.checkbox-label input:checked~.checkmark:after{display:block}.shortcuts-list{display:flex;flex-direction:column;gap:12px}.shortcut-item{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid #f0f0f0}.shortcut-item:last-child{border-bottom:none}.shortcut-item kbd{background:#f5f5f5;border:1px solid #ccc;border-radius:4px;padding:4px 8px;font-family:monospace;font-size:12px;color:#333;box-shadow:0 2px #d0d0d0}.shortcut-item span{color:#666;font-size:14px}.panel-actions{display:flex;gap:12px;padding:16px 24px 24px;border-top:1px solid #e0e0e0}.validate-button,.reset-button{padding:12px 20px;border-radius:6px;font-size:14px;font-weight:500;cursor:pointer;transition:all .2s ease;border:none;min-height:44px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.validate-button{background:#2196f3;color:#fff}.validate-button:hover{background:#1976d2}.reset-button{background:#f5f5f5;color:#333;border:1px solid #ddd}.reset-button:hover{background:#e0e0e0}.validate-button:focus,.reset-button:focus{outline:2px solid #2196F3;outline-offset:2px}.app.dark-theme .accessibility-panel{background:#1e1e1e;color:#ccc}.app.dark-theme .panel-header{border-bottom-color:#444}.app.dark-theme .panel-header h2,.app.dark-theme .close-button{color:#ccc}.app.dark-theme .close-button:hover{background:#333;color:#fff}.app.dark-theme .settings-section h3{color:#ccc;border-bottom-color:#64b5f6}.app.dark-theme .setting-item label{color:#ccc}.app.dark-theme .setting-item input[type=range]{background:#444}.app.dark-theme .setting-item input[type=range]::-webkit-slider-thumb{background:#64b5f6}.app.dark-theme .setting-item input[type=range]::-moz-range-thumb{background:#64b5f6}.app.dark-theme .setting-description{color:#999}.app.dark-theme .checkmark{background-color:#444}.app.dark-theme .checkbox-label:hover input~.checkmark{background-color:#555}.app.dark-theme .checkbox-label input:checked~.checkmark{background-color:#64b5f6}.app.dark-theme .shortcut-item{border-bottom-color:#333}.app.dark-theme .shortcut-item kbd{background:#333;border-color:#555;color:#ccc;box-shadow:0 2px #222}.app.dark-theme .shortcut-item span{color:#999}.app.dark-theme .panel-actions{border-top-color:#444}.app.dark-theme .reset-button{background:#333;color:#ccc;border-color:#555}.app.dark-theme .reset-button:hover{background:#444}.app.high-contrast .accessibility-panel{background:#fff;border:2px solid black}.app.high-contrast .panel-header,.app.high-contrast .panel-actions{border-color:#000;border-width:2px}.app.high-contrast .panel-header h2,.app.high-contrast .setting-item label{color:#000}.app.high-contrast .close-button{color:#000;border:1px solid black}.app.high-contrast .close-button:hover{background:#000;color:#fff}.app.high-contrast .settings-section h3{color:#000;border-bottom-color:#000;border-width:2px}.app.high-contrast .setting-item input[type=range]{background:#000;border:2px solid black}.app.high-contrast .setting-item input[type=range]::-webkit-slider-thumb{background:#000;border:2px solid black}.app.high-contrast .checkmark{background:#fff;border:2px solid black}.app.high-contrast .checkbox-label input:checked~.checkmark{background:#000}.app.high-contrast .shortcut-item kbd{background:#fff;border:2px solid black;color:#000}.app.high-contrast .validate-button{background:#000;color:#fff;border:2px solid black}.app.high-contrast .reset-button{background:#fff;color:#000;border:2px solid black}@media(max-width:768px){.accessibility-overlay{padding:10px}.accessibility-panel{max-height:80vh}.panel-header{padding:20px 20px 12px}.panel-header h2{font-size:20px}.panel-content{padding:12px 20px}.settings-section{margin-bottom:24px}.settings-section h3{font-size:16px}.panel-actions{padding:12px 20px 20px;flex-direction:column}.validate-button,.reset-button{width:100%}}@media(prefers-reduced-motion:reduce){.accessibility-overlay,.accessibility-panel,.close-button,.checkmark,.validate-button,.reset-button{transition:none}}.close-button:focus,.validate-button:focus,.reset-button:focus,.setting-item input[type=range]:focus{outline:3px solid #2196F3;outline-offset:2px}.app.dark-theme .close-button:focus,.app.dark-theme .validate-button:focus,.app.dark-theme .reset-button:focus,.app.dark-theme .setting-item input[type=range]:focus{outline-color:#64b5f6}.app.high-contrast .close-button:focus,.app.high-contrast .validate-button:focus,.app.high-contrast .reset-button:focus,.app.high-contrast .setting-item input[type=range]:focus{outline-color:#000;outline-width:3px}.accessibility-panel input,.accessibility-panel textarea,.accessibility-panel [contenteditable=true]{user-select:auto!important;-webkit-user-select:auto!important;-moz-user-select:auto!important;-ms-user-select:auto!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
/*$vite$:1*/
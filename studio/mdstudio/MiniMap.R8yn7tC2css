.minimap-panel{position:fixed;width:240px;max-height:450px;background-color:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:var(--ms-radius-lg);box-shadow:var(--ms-shadow-lg);display:flex;flex-direction:column;z-index:900;overflow:hidden;user-select:none;-webkit-user-select:none;animation:minimapPuffIn .25s cubic-bezier(.16,1,.3,1)}@keyframes minimapPuffIn{0%{opacity:0;transform:scale(.95) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}.minimap-panel.dragging{cursor:grabbing!important;transform:scale(1.02);opacity:.9;transition:transform .1s ease}.minimap-header{padding:10px 14px;background-color:var(--ms-bg-muted);border-bottom:1px solid var(--ms-border);display:flex;justify-content:space-between;align-items:center;cursor:grab;flex-shrink:0}.minimap-title{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ms-fg-muted)}.minimap-title .title-icon{color:var(--ms-accent);font-size:13px}.minimap-close{background:transparent;border:none;width:32px;height:32px;border-radius:var(--ms-radius-sm);display:flex;align-items:center;justify-content:center;font-size:16px;cursor:pointer;color:var(--ms-fg-muted);transition:all .15s ease}.minimap-close:focus-visible{outline:2px solid var(--ms-accent);outline-offset:2px}.minimap-close:hover{background:#b84a321f;color:var(--ms-accent)}.minimap-content{flex:1;padding:4px 6px;overflow-y:auto;position:relative;display:flex;flex-direction:column;gap:2px;height:100%}.minimap-content::-webkit-scrollbar{width:4px}.minimap-content::-webkit-scrollbar-track{background:transparent}.minimap-content::-webkit-scrollbar-thumb{background:var(--ms-border);border-radius:2px}.minimap-content::-webkit-scrollbar-thumb:hover{background:var(--ms-fg-faint)}.minimap-line{font-family:DM Mono,Cascadia Code,monospace;font-size:10px;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:3px 5px;border-radius:2px;color:var(--ms-fg-muted);cursor:pointer;transition:all .12s ease;min-height:18px;display:flex;align-items:center;border:1px solid transparent}.minimap-line:hover{background:var(--ms-accent-light);color:var(--ms-accent);border-color:var(--ms-accent-light);transform:translate(2px)}.minimap-line.h1{font-weight:800;color:var(--ms-fg);font-size:11px;background:transparent;border-color:transparent}.minimap-line.h2{font-weight:700;color:var(--ms-fg);font-size:11px}.minimap-line.h3{font-weight:600;color:var(--ms-fg);font-size:10px}.minimap-line.current{background:var(--ms-accent-mid);color:var(--ms-accent);font-weight:600;border-color:var(--ms-accent-light)}.viewport-indicator{position:absolute;left:0;right:0;background:var(--ms-accent-light);border-top:1px solid var(--ms-accent);border-bottom:1px solid var(--ms-accent);pointer-events:none;z-index:5;transition:top .1s linear}.minimap-panel.inline-mode .minimap-header{display:none}.dark-theme .minimap-panel{background:var(--ms-bg-elevated);border-color:var(--ms-border)}.dark-theme .minimap-line{color:var(--ms-fg-muted)}.dark-theme .minimap-line:hover{background:var(--ms-accent-light);color:var(--ms-accent)}.dark-theme .viewport-indicator{background:var(--ms-accent-light);border-color:var(--ms-accent)}
/*$vite$:1*/
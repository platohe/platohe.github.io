.citation-picker-surface{max-width:500px}.citation-picker-body{display:flex;flex-direction:column;gap:12px;min-height:200px}.citation-search{width:100%}.citation-hint{font-size:12px;color:var(--ms-fg-muted);margin:0}.citation-loading,.citation-empty{font-size:13px;color:var(--ms-fg-muted);text-align:center;padding:20px}.citation-results{max-height:300px;overflow-y:auto;border:1px solid var(--ms-border);border-radius:6px}.citation-item{padding:10px 12px;cursor:pointer;border-bottom:1px solid var(--ms-border);transition:background .15s}.citation-item:last-child{border-bottom:none}.citation-item:hover{background:var(--ms-bg-elevated)}.citation-item-title{font-size:13px;font-weight:500}.citation-item-meta{font-size:11px;color:var(--ms-fg-muted);margin-top:2px}.citation-manual{display:flex;flex-direction:column;gap:8px}.citation-picker-footer{display:flex;gap:8px;justify-content:flex-end;margin-top:8px}.mt-2{margin-top:8px}
/*$vite$:1*/
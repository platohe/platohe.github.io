.search-results-panel{display:flex;flex-direction:column;height:100%;overflow:hidden}.search-input-wrapper{position:relative;padding:12px;border-bottom:1px solid var(--ms-border)}.search-icon{position:absolute;left:28px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--ms-fg-muted);pointer-events:none}.search-input{width:100%;padding:8px 32px 8px 36px;border:1px solid var(--ms-border);border-radius:6px;background:var(--ms-bg-elevated);color:var(--ms-fg);font-size:14px;outline:none;transition:border-color .15s}.search-input:focus{border-color:var(--ms-accent);box-shadow:0 0 0 2px color-mix(in srgb,var(--ms-accent) 20%,transparent)}.search-clear-btn{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--ms-fg-muted);font-size:20px;cursor:pointer;padding:4px 8px;line-height:1;border-radius:4px}.search-clear-btn:hover{color:var(--ms-fg);background:var(--ms-bg-hover)}.search-filters{display:flex;flex-wrap:wrap;gap:12px;padding:10px 12px;border-bottom:1px solid var(--ms-border);align-items:center}.search-filter-group{display:flex;align-items:center;gap:6px}.filter-label{font-size:12px;color:var(--ms-fg-muted);font-weight:500;white-space:nowrap}.tag-filters{display:flex;flex-wrap:wrap;gap:4px}.tag-filter-btn{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border:1px solid var(--ms-border);border-radius:12px;background:var(--ms-bg);color:var(--ms-fg-muted);font-size:12px;cursor:pointer;transition:all .15s}.tag-filter-btn:hover{border-color:var(--ms-accent);color:var(--ms-fg)}.tag-filter-btn.active{background:var(--ms-accent);border-color:var(--ms-accent);color:var(--ms-bg)}.tag-filter-count{font-size:10px;opacity:.7}.date-filter-select,.sort-select{padding:4px 8px;border:1px solid var(--ms-border);border-radius:4px;background:var(--ms-bg-elevated);color:var(--ms-fg);font-size:12px;cursor:pointer;outline:none}.date-filter-select:focus,.sort-select:focus{border-color:var(--ms-accent)}.search-mode-toggle{display:inline-flex;border:1px solid var(--ms-border);border-radius:4px;overflow:hidden}.search-mode-btn{display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border:none;background:var(--ms-bg);color:var(--ms-fg-muted);font-size:11px;cursor:pointer;transition:all .15s;white-space:nowrap}.search-mode-btn+.search-mode-btn{border-left:1px solid var(--ms-border)}.search-mode-btn:hover{background:var(--ms-bg-hover);color:var(--ms-fg)}.search-mode-btn.active{background:var(--ms-accent);color:var(--ms-bg)}.search-mode-icon{font-weight:700;font-size:10px;font-family:monospace}.search-mode-label{font-size:11px}.search-mode-indicator{font-weight:400;opacity:.7}.search-results-content{flex:1;overflow-y:auto;padding:8px}.search-loading,.search-empty{padding:24px 16px;text-align:center;color:var(--ms-fg-muted);font-size:14px}.search-result-count{padding:8px 12px;font-size:12px;color:var(--ms-fg-muted);border-bottom:1px solid var(--ms-border);margin-bottom:4px}.search-results-list{list-style:none;margin:0;padding:0}.search-result-item{padding:10px 12px;border-radius:6px;cursor:pointer;transition:background .1s;margin-bottom:2px}.search-result-item:hover,.search-result-item:focus-visible{background:var(--ms-bg-hover);outline:none}.search-result-item:focus-visible{box-shadow:0 0 0 2px var(--ms-accent)}.search-result-header{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:4px}.search-result-name{font-weight:600;font-size:14px;color:var(--ms-fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.search-result-meta{font-size:11px;color:var(--ms-fg-muted);white-space:nowrap}.search-result-tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px}.search-result-tag{font-size:11px;padding:1px 6px;border-radius:10px;background:color-mix(in srgb,var(--ms-accent) 15%,transparent);color:var(--ms-accent)}.search-result-snippet{font-size:13px;color:var(--ms-fg-muted);line-height:1.4;word-break:break-word}.search-result-snippet mark{background:color-mix(in srgb,var(--ms-accent) 30%,transparent);color:inherit;border-radius:2px;padding:0 1px}.search-results-panel.dark .search-input{background:var(--ms-bg)}
/*$vite$:1*/
.help-window-container.is-mobile{position:fixed!important;left:50%!important;top:50%!important;transform:translate(-50%,-50%)!important;width:min(95vw,500px)!important;height:80vh!important;margin:0!important;animation:helpWindowFadeIn .25s cubic-bezier(.16,1,.3,1)}@keyframes helpWindowFadeIn{0%{opacity:0;transform:translate(-50%,-40%) scale(.98)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}.help-window-container{background-color:var(--ms-bg-elevated);box-shadow:var(--ms-shadow-lg);border:1px solid var(--ms-border);z-index:9999;display:flex;flex-direction:column;border-radius:var(--ms-radius-lg);overflow:hidden}
/*$vite$:1*/
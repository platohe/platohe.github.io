.collab-panel{padding:16px;display:flex;flex-direction:column;gap:16px}.collab-panel-header{display:flex;justify-content:space-between;align-items:center}.collab-panel-header h3{margin:0;font-size:14px;font-weight:600}.collab-desc{font-size:12px;color:var(--ms-fg-muted);margin:0 0 12px}.collab-room-input{width:100%;margin-bottom:8px}.collab-connect-btn,.collab-disconnect-btn{width:100%;margin-top:8px}.collab-active{display:flex;flex-direction:column;gap:16px}.collab-peers h4,.collab-share h4{margin:0 0 8px;font-size:12px;font-weight:600;color:var(--ms-fg-muted)}.collab-no-peers{font-size:12px;color:var(--ms-fg-muted);font-style:italic}.peer-badge{display:flex;align-items:center;gap:8px;padding:6px 8px;background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:4px}.peer-dot{width:8px;height:8px;border-radius:50%;background:var(--peer-color, #0369A1);flex-shrink:0}.peer-name{font-size:12px;font-weight:500}.collab-share{display:flex;flex-direction:column;gap:8px}.collab-share-url{font-size:11px}.collab-copy-btn{align-self:flex-start}.collab-info{font-size:11px;color:var(--ms-fg-muted);text-align:center;padding-top:8px;border-top:1px solid var(--ms-border)}.collab-status{display:flex;align-items:center;gap:6px;font-size:11px;padding:4px 8px;border-radius:4px;background:var(--ms-bg-elevated);border:1px solid var(--ms-border)}.collab-status--connected .status-dot{background:#22c55e}.collab-status--connecting .status-dot{background:#f59e0b;animation:pulse 1s infinite}.collab-status--disconnected .status-dot{background:#ef4444}.status-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}@keyframes pulse{0%,to{opacity:1}50%{opacity:.4}}.cm-collaboration-cursor{border-left:2px solid var(--peer-color, #0369A1);height:100%;margin-left:-1px}.cm-collaboration-selection{background:#0369a133;border-radius:1px}
/*$vite$:1*/
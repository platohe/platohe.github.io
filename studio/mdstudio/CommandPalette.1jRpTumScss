.command-palette-overlay{position:fixed;inset:0;background-color:#0006;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:flex;justify-content:center;align-items:flex-start;padding-top:12vh;z-index:5000;pointer-events:none}.command-palette-surface{position:absolute;width:min(540px,95vw);max-width:95vw;max-height:72vh;background-color:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:var(--ms-radius-lg);box-shadow:var(--ms-shadow-lg);display:flex;flex-direction:column;overflow:hidden;user-select:none;-webkit-user-select:none;pointer-events:auto;animation:paletteSpringIn .22s cubic-bezier(.16,1,.3,1);font-family:IBM Plex Sans,sans-serif!important}@keyframes paletteSpringIn{0%{opacity:0;transform:scale(.96) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}.command-palette-surface.dragging{cursor:grabbing!important;transform:scale(1.01);opacity:.92;transition:transform .1s ease}.command-palette-title-bar{padding:12px 18px;background-color:var(--ms-bg-muted);border-bottom:1px solid var(--ms-border);display:flex;justify-content:space-between;align-items:center;cursor:grab}.command-palette-title{display:flex;align-items:center;gap:8px;font-family:IBM Plex Sans,sans-serif!important;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--ms-fg-muted)}.title-icon{color:var(--ms-accent);font-size:14px}.command-palette-close{background:transparent;border:none;width:24px;height:24px;border-radius:var(--ms-radius-sm);display:flex;align-items:center;justify-content:center;font-size:15px;cursor:pointer;color:var(--ms-fg-muted);transition:all .15s ease}.command-palette-close:focus-visible{outline:2px solid var(--ms-accent);outline-offset:2px}.command-palette-close:hover{background:#b84a321f;color:var(--ms-accent)}.command-palette-search-wrapper{display:flex;align-items:center;padding:14px 18px;gap:12px;background:transparent;border-bottom:1px solid var(--ms-border)}.command-palette-icon{font-size:18px;color:var(--ms-fg-muted);flex-shrink:0}.command-palette-input{flex:1;background:transparent;border:none;outline:none!important;font-size:15px;color:var(--ms-fg);font-family:IBM Plex Sans,sans-serif!important;font-weight:400}.command-palette-input::placeholder{color:var(--ms-fg-faint)}.command-palette-content{max-height:380px;overflow-y:auto;padding:8px 0}.command-list{display:flex;flex-direction:column;padding:4px 0}.command-item{display:flex;align-items:center;padding:9px 18px;cursor:pointer;gap:14px;transition:background .1s ease;color:var(--ms-fg);font-family:IBM Plex Sans,sans-serif!important}.command-item:hover{background:var(--ms-bg-muted)}.command-item.selected{background-color:var(--ms-accent-light);color:var(--ms-accent)}.command-item-icon{font-size:16px;width:22px;display:flex;justify-content:center;flex-shrink:0;opacity:.85}.command-item-label{flex:1;font-size:13px;font-weight:500}.command-item-shortcut{font-family:DM Mono,IBM Plex Sans,monospace!important;font-size:11px;font-weight:500;padding:2px 6px;background:var(--ms-bg-muted);border:1px solid var(--ms-border);border-radius:4px;color:var(--ms-fg-muted);letter-spacing:.03em;flex-shrink:0}.command-palette-footer{padding:10px 18px;background-color:var(--ms-bg-muted);border-top:1px solid var(--ms-border);display:flex;gap:20px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--ms-fg-faint);font-family:IBM Plex Sans,sans-serif!important}.command-palette-surface.is-mobile{position:fixed!important;left:50%!important;top:50%!important;transform:translate(-50%,-50%)!important;margin:0!important;animation:paletteFadeInCentered .22s cubic-bezier(.16,1,.3,1);max-height:80vh!important}@keyframes paletteFadeInCentered{0%{opacity:0;transform:translate(-50%,-50%) scale(.97)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
/*$vite$:1*/
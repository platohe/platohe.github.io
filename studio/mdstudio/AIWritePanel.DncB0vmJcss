.ai-write-panel{padding:12px;font-size:13px;overflow-y:auto;height:100%}.ai-write-panel.dark{color:var(--ms-fg)}.ai-style-selector{display:flex;align-items:center;gap:8px;margin-bottom:12px;padding:8px;background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:4px}.ai-style-selector label{font-size:11px;color:var(--ms-fg-muted);text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}.ai-style-select{flex:1;padding:4px 8px;border:1px solid var(--ms-border);border-radius:4px;background:var(--ms-bg);color:var(--ms-fg);font-size:12px;cursor:pointer}.ai-style-select:focus{outline:2px solid var(--ms-accent);outline-offset:1px}.ai-panel-header{font-weight:600;font-size:14px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between}.ai-status-unavailable{font-size:11px;color:var(--ms-fg-muted);font-weight:400}.ai-panel-section{margin-bottom:12px}.ai-panel-section label{display:block;font-size:11px;color:var(--ms-fg-muted);margin-bottom:4px;text-transform:uppercase;letter-spacing:.05em}.ai-selected-text{background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:4px;padding:8px;max-height:80px;overflow-y:auto;font-size:12px;color:var(--ms-fg-muted);white-space:pre-wrap}.ai-panel-actions{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}.ai-panel-actions .fluent-button{font-size:12px;padding:4px 10px}.ai-loading{display:flex;align-items:center;gap:8px;padding:12px;color:var(--ms-fg-muted);font-size:12px}.ai-error{background:#ff00001a;border:1px solid rgba(255,0,0,.3);border-radius:4px;padding:8px 12px;color:#f44;font-size:12px;margin-bottom:12px}.ai-result-section{margin-top:12px;padding-top:12px;border-top:1px solid var(--ms-border)}.ai-result-text{background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:4px;padding:10px;font-size:13px;line-height:1.5;white-space:pre-wrap;max-height:200px;overflow-y:auto;margin-bottom:8px}.ai-result-actions{display:flex;gap:8px}.ai-result-actions .fluent-button{font-size:12px;padding:4px 12px}
/*$vite$:1*/
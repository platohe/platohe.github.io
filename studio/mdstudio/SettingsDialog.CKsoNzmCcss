.settings-dialog-content{width:100%;max-width:800px;padding:0;display:flex;flex-direction:column;font-family:IBM Plex Sans,sans-serif!important}.settings-dialog-main-content{display:flex!important;flex-direction:column!important;width:100%!important;padding:0!important;overflow:hidden!important}.settings-dialog-body{height:100%;display:flex;flex-direction:column;overflow:hidden;padding:0!important}.settings-fixed-header{padding:0 24px;flex-shrink:0;border-bottom:1px solid var(--ms-border)}.settings-dialog-scroll-content{flex:1;overflow-y:auto!important;overflow-x:hidden!important;padding:16px 24px!important}@media(max-width:480px){.settings-dialog-content{min-width:280px;width:95vw;max-width:95vw}}.custom-tabs{display:flex;margin-bottom:0}.tab-button{background:none;border:none;padding:12px 24px;font-family:IBM Plex Sans,sans-serif!important;font-size:13px;font-weight:500;color:var(--ms-fg-muted);cursor:pointer;border-bottom:2px solid transparent;transition:all .15s ease;margin:0;border-radius:0;text-transform:uppercase;letter-spacing:.06em}.tab-button:hover{color:var(--ms-fg);background-color:var(--ms-bg-muted)}.tab-button.active{color:var(--ms-accent);border-bottom-color:var(--ms-accent);background-color:var(--ms-bg);font-weight:600}.tab-button:focus{outline:2px solid var(--ms-accent);outline-offset:1px}.settings-tab-content{width:100%;padding-bottom:24px}.settings-dialog .tab-panel{padding:16px 0}.setting-item{margin-bottom:20px}.setting-item label{display:block;font-family:IBM Plex Sans,sans-serif!important;font-weight:500;color:var(--ms-fg);margin-bottom:7px;font-size:13px}.setting-item input[type=range]{width:100%;height:4px;border-radius:2px;background:var(--ms-border);cursor:pointer;border:2px solid transparent}.setting-item input[type=range]:focus-visible{border-color:var(--ms-accent);outline:none}.setting-item input[type=range]::-webkit-slider-thumb{appearance:none;width:16px;height:16px;border-radius:50%;background:var(--ms-accent);cursor:pointer;border:2px solid var(--ms-bg-elevated);box-shadow:0 1px 4px #0003}.setting-item input[type=range]::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:var(--ms-accent);cursor:pointer;border:2px solid var(--ms-bg-elevated);box-shadow:0 1px 4px #0003}.setting-description{font-size:12px;color:var(--ms-fg-muted);line-height:1.4;margin-top:4px;font-family:IBM Plex Sans,sans-serif!important}.checkbox-label{display:flex!important;align-items:flex-start;gap:10px;cursor:pointer;font-weight:500!important;margin-bottom:8px!important;font-size:13px;color:var(--ms-fg);font-family:IBM Plex Sans,sans-serif!important}.checkbox-label input[type=checkbox]{position:absolute;opacity:0;cursor:pointer;height:0;width:0}.checkmark{position:relative;display:inline-block;height:18px;width:18px;background-color:var(--ms-bg);border:1.5px solid var(--ms-border-strong);border-radius:4px;transition:all .15s ease;flex-shrink:0;margin-top:1px}.checkbox-label:hover input~.checkmark{background-color:var(--ms-bg-muted);border-color:var(--ms-fg-faint)}.checkbox-label input:checked~.checkmark{background-color:var(--ms-accent);border-color:var(--ms-accent)}.checkmark:after{content:"";position:absolute;display:none;left:6px;top:2px;width:4px;height:9px;border:solid white;border-width:0 2px 2px 0;transform:rotate(45deg)}.checkbox-label input:checked~.checkmark:after{display:block}.shortcuts-list{display:flex;flex-direction:column;gap:10px}.shortcut-item{display:flex;align-items:center;gap:12px;padding:7px 0;border-bottom:1px solid var(--ms-border)}.shortcut-item:last-child{border-bottom:none}.shortcut-item kbd{background:var(--ms-bg-muted);border:1px solid var(--ms-border);border-radius:4px;padding:3px 8px;font-family:DM Mono,monospace;font-size:11px;color:var(--ms-fg);box-shadow:0 1px 0 var(--ms-border)}.shortcut-item span{color:var(--ms-fg-muted);font-size:13px;font-family:IBM Plex Sans,sans-serif!important}.settings-section{margin-bottom:24px}.settings-section h3{margin:0 0 14px;font-size:15px;font-weight:600;color:var(--ms-fg);font-family:IBM Plex Sans,sans-serif!important}.settings-section .field{margin-bottom:14px}.settings-section .field label{font-weight:500;margin-bottom:4px;display:block;font-size:13px;color:var(--ms-fg);font-family:IBM Plex Sans,sans-serif!important}.settings-dialog-surface{max-height:80vh!important;max-width:95vw!important;height:min(650px,80vh)!important;width:min(560px,95vw)!important;display:flex!important;flex-direction:column!important;font-family:IBM Plex Sans,sans-serif!important}@media(max-width:480px){.fui-DialogSurface{max-width:98vw!important}}.settings-dialog-actions{display:flex;gap:10px;justify-content:flex-end;padding:14px 24px!important;border-top:1px solid var(--ms-border)!important;flex-shrink:0;background-color:var(--ms-bg-muted)}.settings-dialog-actions button{min-width:90px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:IBM Plex Sans,sans-serif!important}.settings-dialog-content input[type=number]{width:80px}.settings-dialog-content .select{width:100%}.theme-select{width:100%;padding:7px 10px;border:1px solid var(--ms-border);border-radius:var(--ms-radius-sm);background-color:var(--ms-bg);color:var(--ms-fg);font-size:13px;font-family:IBM Plex Sans,sans-serif!important;transition:border-color .15s ease,box-shadow .15s ease;outline:none}.theme-select:focus{border-color:var(--ms-accent);box-shadow:0 0 0 3px var(--ms-accent-light)}.fui-DialogSurface *,.fui-DialogContent *,.fui-DialogTitle *{-webkit-user-select:none!important;-moz-user-select:none!important;-ms-user-select:none!important;user-select:none!important}.fui-DialogContent input,.fui-DialogContent textarea,.fui-DialogContent [contenteditable=true]{-webkit-user-select:auto!important;-moz-user-select:auto!important;-ms-user-select:auto!important;user-select:auto!important}.app.dark-theme div.settings-dialog-content div.tab-panel div.settings-section div.setting-item label.checkbox-label input[type=checkbox]+.checkmark{background-color:var(--ms-bg-muted)!important;border:1.5px solid var(--ms-border-strong)!important}.app.dark-theme div.settings-dialog-content div.tab-panel div.settings-section div.setting-item label.checkbox-label:hover input[type=checkbox]+.checkmark{background-color:var(--ms-bg)!important;border-color:var(--ms-fg-faint)!important}.app.dark-theme div.settings-dialog-content div.tab-panel div.settings-section div.setting-item label.checkbox-label input[type=checkbox]:checked+.checkmark{background-color:var(--ms-accent)!important;border-color:var(--ms-accent)!important}.app.dark-theme .theme-select{background-color:var(--ms-bg)!important;color:var(--ms-fg)!important;border-color:var(--ms-border-strong)!important}.app.dark-theme .theme-select option{background-color:var(--ms-bg-elevated)!important;color:var(--ms-fg)!important}.app.dark-theme .fui-Select__list,.app.dark-theme [data-fui-select-list],.app.dark-theme .fui-Select__listbox{background-color:var(--ms-bg-elevated)!important;border:1px solid var(--ms-border-strong)!important}.app.dark-theme .fui-Select__option,.app.dark-theme [data-fui-select-option],.app.dark-theme .fui-Select__option[role=option]{background-color:var(--ms-bg-elevated)!important;color:var(--ms-fg)!important}.app.dark-theme .fui-Select__option:hover,.app.dark-theme [data-fui-select-option]:hover,.app.dark-theme .fui-Select__option[role=option]:hover{background-color:var(--ms-bg-muted)!important}.app.dark-theme .fui-Select__option[data-selected],.app.dark-theme [data-fui-select-option][data-selected],.app.dark-theme .fui-Select__option[role=option][data-selected]{background-color:var(--ms-accent)!important;color:#fff!important}.app.dark-theme .setting-item label{color:var(--ms-fg)!important}.app.dark-theme .setting-description{color:var(--ms-fg-muted)!important}.app.dark-theme .settings-section h3{color:var(--ms-fg)!important}.settings-dialog-content .field .switch-label{font-size:13px;color:var(--ms-fg-muted);font-family:IBM Plex Sans,sans-serif!important}.ai-detect-row{display:flex;align-items:center;gap:12px;margin-top:8px}.ai-status-ok{color:#10b981;font-size:13px}.ai-status-error{color:#ef4444;font-size:13px}.ai-status-pending{color:var(--ms-fg-muted);font-size:13px}.ai-status-bar{margin-top:12px;padding:8px 12px;border-radius:6px;background:var(--ms-bg);font-size:13px}.ai-setup-section{margin-bottom:12px}.ai-setup-panel{margin-top:12px;padding:12px;border:1px solid var(--ms-border);border-radius:8px;background:var(--ms-bg-elevated)}.ai-setup-group{margin-bottom:12px}.ai-setup-group label{display:block;font-size:12px;font-weight:600;color:var(--ms-fg-muted);margin-bottom:4px}.ai-url-row{display:flex;gap:8px;align-items:center}.ai-api-key-input,.ai-url-input{width:100%;padding:6px 10px;border:1px solid var(--ms-border);border-radius:4px;background:var(--ms-bg);color:var(--ms-fg);font-size:13px}.ai-model-section{margin-top:8px}.ai-model-select{margin-top:4px;width:100%}.kb-hint{font-size:12px;color:var(--ms-fg-muted);margin-bottom:12px}.kb-table{width:100%;border-collapse:collapse;font-size:13px}.kb-table th{text-align:left;padding:8px 12px;border-bottom:2px solid var(--ms-border);font-weight:600;color:var(--ms-fg)}.kb-table td{padding:6px 12px;border-bottom:1px solid var(--ms-border);vertical-align:middle}.kb-row.custom td{background:color-mix(in srgb,var(--ms-accent) 5%,var(--ms-bg))}.kb-action{color:var(--ms-fg)}.kb-key-cell{text-align:right}.kb-key-btn{background:none;border:1px solid var(--ms-border);border-radius:4px;padding:4px 12px;cursor:pointer;font-size:13px;color:var(--ms-fg);transition:all .15s}.kb-key-btn:hover{border-color:var(--ms-accent);color:var(--ms-accent)}.kb-key-btn kbd{font-family:Cascadia Code,monospace;font-size:12px;padding:2px 6px;background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:3px;color:var(--ms-fg)}.kb-edit-row{display:flex;gap:6px;align-items:center}.kb-edit-input{flex:1;padding:4px 8px;border:1px solid var(--ms-accent);border-radius:4px;background:var(--ms-bg);color:var(--ms-fg);font-size:13px;font-family:Cascadia Code,monospace}.kb-actions{margin-top:16px}.kb-th-action{width:60%}.kb-th-key{width:40%;text-align:right}

.writing-coach-panel{padding:16px;display:flex;flex-direction:column;gap:12px}.coach-desc{font-size:12px;color:var(--ms-fg-muted);margin:0}.coach-analyze-btn{width:100%}.coach-error{margin:0}.coach-stats{background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:6px;padding:12px}.coach-stats h4{margin:0 0 8px;font-size:13px}.stat-row{display:flex;justify-content:space-between;font-size:12px;padding:4px 0;border-bottom:1px solid var(--ms-border)}.stat-row:last-child{border-bottom:none}.readability-bar{height:8px;background:var(--ms-bg);border-radius:4px;margin-top:8px;overflow:hidden}.readability-fill{height:100%;border-radius:4px;transition:width .3s ease}.coach-suggestions{display:flex;flex-direction:column;gap:8px}.coach-suggestions h4{margin:0 0 4px;font-size:13px}.suggestion-card{background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:6px;padding:10px;display:flex;flex-direction:column;gap:4px}.suggestion-type{font-size:11px;font-weight:600;text-transform:uppercase;color:var(--ms-accent)}.suggestion-before,.suggestion-after,.suggestion-reason{font-size:12px;line-height:1.4}.suggestion-before{color:var(--ms-fg-muted);text-decoration:line-through}.suggestion-after{color:#22c55e}.suggestion-reason{font-style:italic;color:var(--ms-fg-muted)}.suggestion-card button{align-self:flex-start;margin-top:4px}
/*$vite$:1*/
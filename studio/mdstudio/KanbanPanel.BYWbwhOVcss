.kanban-panel{display:flex;flex-direction:column;height:100%;overflow:hidden}.kanban-header{display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid var(--ms-border)}.kanban-header h3{margin:0;font-size:14px;font-weight:600}.kanban-hint{font-size:11px;color:var(--ms-fg-muted)}.kanban-board{display:flex;gap:8px;padding:8px;overflow-x:auto;flex:1;align-items:flex-start}.kanban-column{flex:1;min-width:180px;max-width:260px;background:var(--ms-bg);border-radius:8px;border:1px solid var(--ms-border);display:flex;flex-direction:column;min-height:100px;transition:border-color .15s,background .15s}.kanban-column.drag-over{border-color:var(--ms-accent);background:color-mix(in srgb,var(--ms-accent) 5%,var(--ms-bg))}.kanban-column-header{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border-bottom:2px solid var(--col-color, var(--ms-accent))}.kanban-column-title{font-size:13px;font-weight:600;color:var(--ms-fg)}.kanban-column-count{font-size:11px;padding:1px 6px;border-radius:10px;background:var(--ms-bg-elevated);color:var(--ms-fg-muted);font-weight:500}.kanban-uncategorized-header{border-bottom-color:#94a3b8}.kanban-cards{padding:8px;display:flex;flex-direction:column;gap:6px;overflow-y:auto;flex:1}.kanban-card{background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:6px;padding:8px 10px;cursor:grab;transition:box-shadow .15s,transform .1s;position:relative;overflow:hidden}.kanban-card:hover{box-shadow:0 2px 8px color-mix(in srgb,var(--ms-fg) 10%,transparent);border-color:var(--ms-accent)}.kanban-card:active{cursor:grabbing}.kanban-card.dragging{opacity:.5;transform:scale(.98)}.kanban-card-accent{position:absolute;top:0;left:0;right:0;height:3px;background:var(--card-accent, var(--ms-accent));border-radius:6px 6px 0 0}.kanban-card-title{font-size:13px;font-weight:600;color:var(--ms-fg);margin-top:6px;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.kanban-card-preview{font-size:11px;color:var(--ms-fg-muted);line-height:1.3;margin-bottom:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.kanban-card-tags{display:flex;flex-wrap:wrap;gap:3px}.kanban-tag{font-size:10px;padding:1px 5px;border-radius:10px;background:color-mix(in srgb,var(--ms-accent) 12%,transparent);color:var(--ms-accent)}.kanban-column .kanban-cards:empty:after{content:"No tasks";display:block;text-align:center;color:var(--ms-fg-muted);font-size:12px;padding:16px;font-style:italic}@media(max-width:768px){.kanban-board{flex-direction:column;overflow-x:hidden;overflow-y:auto}.kanban-column{min-width:100%;max-width:100%}}
/*$vite$:1*/
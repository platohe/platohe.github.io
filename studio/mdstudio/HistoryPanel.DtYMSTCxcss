.history-panel{display:flex;flex-direction:column;height:100%;background-color:var(--ms-bg);color:var(--ms-fg);font-family:IBM Plex Sans,sans-serif!important}.history-panel:not(.inline-mode){position:fixed;z-index:1000;width:min(300px,95vw);max-width:95vw;height:min(500px,80vh);max-height:80vh;box-shadow:var(--ms-shadow-lg);border:1px solid var(--ms-border);border-radius:var(--ms-radius-lg);overflow:hidden;animation:historyPuffIn .25s cubic-bezier(.16,1,.3,1);background:var(--ms-bg-elevated)}@keyframes historyPuffIn{0%{opacity:0;transform:scale(.95) translateY(-10px)}to{opacity:1;transform:scale(1) translateY(0)}}.history-panel.dragging{opacity:.9;transform:scale(1.02);cursor:grabbing!important;transition:transform .1s ease}.history-header{padding:12px 16px;background-color:var(--ms-bg-muted);display:flex;align-items:center;justify-content:space-between;gap:8px;font-weight:600;border-bottom:1px solid var(--ms-border);cursor:grab;flex-shrink:0}.history-panel.inline-mode .history-header{cursor:default}.history-header-title{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ms-fg-muted)}.history-close{background:transparent;border:none;width:24px;height:24px;border-radius:var(--ms-radius-sm);display:flex;align-items:center;justify-content:center;font-size:15px;cursor:pointer;color:var(--ms-fg-muted);transition:all .15s ease}.history-close:focus-visible{outline:2px solid var(--ms-accent);outline-offset:2px}.history-close:hover{background:#b84a321f;color:var(--ms-accent)}.history-panel.inline-mode .history-close{display:none}.history-list-container{flex:1;overflow-y:auto;padding:6px 0}.history-list{display:flex;flex-direction:column;gap:2px}.history-item{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-radius:var(--ms-radius-sm);cursor:pointer;background:transparent;transition:background .12s ease;border:1px solid transparent}.history-item:hover{background:var(--ms-bg-muted);border-color:var(--ms-border)}.history-item-info{display:flex;flex-direction:column;gap:2px;width:70%}.history-time{font-size:12px;font-weight:600;color:var(--ms-fg)}.history-preview{font-size:11px;color:var(--ms-fg-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.history-item-actions{display:flex;gap:4px;opacity:0;transition:opacity .15s ease}.history-item:hover .history-item-actions{opacity:1}.history-empty,.history-status{padding:32px;text-align:center;font-size:13px;color:var(--ms-fg-muted)}.history-footer{padding:8px 16px;border-top:1px solid var(--ms-border);display:flex;justify-content:center;flex-shrink:0}.history-confirm-overlay{position:fixed;inset:0;z-index:10001;display:flex;align-items:center;justify-content:center;background:#00000080}.history-confirm-dialog{background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:var(--ms-radius-lg);padding:24px;max-width:400px;width:90%;box-shadow:var(--ms-shadow-lg);font-family:IBM Plex Sans,sans-serif!important}.history-confirm-dialog p{margin-bottom:20px;line-height:1.5;color:var(--ms-fg)}.history-confirm-actions{display:flex;gap:12px;justify-content:flex-end}.history-confirm-cancel,.history-confirm-restore{padding:8px 16px;border-radius:var(--ms-radius-md);font-size:14px;font-weight:500;cursor:pointer;border:1px solid var(--ms-border);transition:background .15s ease;font-family:IBM Plex Sans,sans-serif!important}.history-confirm-cancel{background:var(--ms-bg-muted);color:var(--ms-fg)}.history-confirm-cancel:hover{background:var(--ms-border)}.history-confirm-restore{background:var(--ms-accent);color:#fff;border-color:var(--ms-accent)}.history-confirm-restore:hover{filter:brightness(1.1)}.history-item-wrapper{border-bottom:1px solid var(--ms-border)}.history-item{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;cursor:pointer;transition:background .1s}.history-item:hover{background:var(--ms-bg-hover)}.history-badge{font-size:11px;padding:1px 6px;border-radius:10px;background:var(--ms-accent);color:var(--ms-bg);margin-left:8px}.ms-diff-container{margin-top:8px;border:1px solid var(--ms-border);border-radius:6px;overflow:hidden;max-height:300px;overflow-y:auto;font-family:Cascadia Code,Fira Code,JetBrains Mono,monospace;font-size:12px;line-height:1.5}.ms-diff{width:100%;border-collapse:collapse}.ms-diff-line{display:flex;align-items:baseline;padding:1px 8px;gap:8px}.ms-diff-same{background:var(--ms-bg-elevated);color:var(--ms-fg-muted)}.ms-diff-add{background:color-mix(in srgb,#10B981 12%,var(--ms-bg));color:#059669}.ms-diff-rm{background:color-mix(in srgb,#EF4444 12%,var(--ms-bg));color:#dc2626}.ms-diff-divider{background:var(--ms-bg-muted);color:var(--ms-fg-muted);font-style:italic;text-align:center;padding:2px 8px;font-size:11px}.ms-diff-ln{display:inline-block;width:32px;text-align:right;color:var(--ms-fg-muted);opacity:.5;-webkit-user-select:none;user-select:none;flex-shrink:0}.ms-diff-content{flex:1;white-space:pre-wrap;word-break:break-word;min-width:0}.ms-diff-add .ms-diff-content:before{content:"+ ";color:#059669;font-weight:700}.ms-diff-rm .ms-diff-content:before{content:"- ";color:#dc2626;font-weight:700}.ms-diff-same .ms-diff-content:before{content:"  "}.history-diff-toggle{display:flex;align-items:center;gap:6px;padding:6px 12px;background:var(--ms-bg-muted);border:none;border-radius:4px;color:var(--ms-accent);font-size:12px;cursor:pointer;width:100%;text-align:left;transition:background .15s}.history-diff-toggle:hover{background:color-mix(in srgb,var(--ms-accent) 10%,var(--ms-bg-muted))}.history-diff-toggle:focus-visible{outline:2px solid var(--ms-accent);outline-offset:1px}.history-diff-toggle .diff-chevron{transition:transform .2s;font-size:10px}.history-diff-toggle.open .diff-chevron{transform:rotate(180deg)}
/*$vite$:1*/
@import"https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css";.writing-stats{--status-height: 28px;background:var(--ms-bg-muted)!important;border-top:1px solid var(--ms-border)!important;padding:0;font-family:IBM Plex Sans,-apple-system,sans-serif!important;transition:opacity .2s ease;overflow:hidden;height:100%;width:100%;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;letter-spacing:.02em}.writing-stats:hover{opacity:1}.stats-line{display:flex;flex-wrap:nowrap;align-items:center;gap:0;min-width:max-content;padding:0;height:100%}.stat-item{display:inline-flex;align-items:center;gap:.3rem;padding:0 .5rem;height:var(--status-height);transition:background-color .12s ease;color:var(--ms-fg-muted);font-size:.72rem;line-height:var(--status-height);white-space:nowrap;font-family:IBM Plex Sans,sans-serif!important;text-transform:uppercase;letter-spacing:.05em}.stat-item:hover{background-color:var(--ms-bg)}.stat-text{opacity:.9}.stat-icon{font-size:.75rem}@media(max-width:900px){.stat-item{padding:0 .3rem;font-size:.68rem}}.goal-container{display:flex;align-items:center;margin-right:12px;height:100%}.goal-progress-wrapper{position:relative;width:100px;height:14px;background:var(--ms-bg);border-radius:7px;overflow:hidden;cursor:pointer;display:flex;align-items:center;justify-content:center;border:1px solid var(--ms-border);box-shadow:inset 0 1px 2px #0000000f}.dark-theme .goal-progress-wrapper{box-shadow:inset 0 1px 2px #0003}.goal-progress-bar{position:absolute;left:0;top:0;height:100%;background:var(--ms-accent);transition:width .5s cubic-bezier(.4,0,.2,1);z-index:1}.goal-text{position:relative;z-index:2;font-family:IBM Plex Sans,sans-serif!important;font-size:10px;font-weight:700;color:var(--ms-fg);text-shadow:0 0 2px rgba(255,255,255,.6);display:flex;align-items:center;letter-spacing:.04em}.dark-theme .goal-text{text-shadow:0 0 2px rgba(0,0,0,.6)}.focus-mode-overlay{position:absolute;inset:0;background:#00000040;pointer-events:none;z-index:1}.focus-line-highlight{position:absolute;left:0;right:0;background:var(--ms-bg-muted);pointer-events:none;z-index:2;transition:all .2s ease;border-radius:3px}.zen-mode .ribbon-menu,.zen-mode .file-tabs,.zen-mode .accessibility-panel,.zen-mode .writing-stats-wrapper{display:none!important}.zen-mode .editor-scroll-container{margin:0!important;padding:0!important}.zen-mode .editor-container{max-width:none!important;margin:0!important;padding:2rem!important}.zen-mode .writing-stats{position:fixed;bottom:1rem;right:1rem;background:#000000bf;border:1px solid rgba(255,255,255,.15);color:#ffffffd9;max-width:200px;opacity:.65;transition:opacity .2s ease;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}.zen-mode .writing-stats:hover{opacity:1}.zen-mode .stat-item{background:#ffffff14}.zen-mode .stat-value{color:#fff}.zen-mode .stat-label{color:#ffffffb3}.zen-mode .streak-message{background:#4caf5033;color:#fff}.zen-mode .progress-bar{background:#ffffff26}.zen-mode .goal-item span:first-child,.zen-mode .goal-percentage{color:#ffffffbf}.writing-stats-wrapper{background:var(--ms-bg-muted);border-top:1px solid var(--ms-border);flex-shrink:0;height:28px;padding:0 .5rem;display:flex;justify-content:space-between;align-items:center;z-index:100;overflow:hidden}.dark-theme .writing-stats-wrapper{background:var(--ms-bg-muted);border-top-color:var(--ms-border)}@keyframes progressPulse{0%{opacity:.8}50%{opacity:1}to{opacity:.8}}.progress-fill{animation:progressPulse 2s ease-in-out infinite}@media(prefers-reduced-motion:reduce){.progress-fill{animation:none}}@media(max-width:768px){.writing-stats,.writing-stats-wrapper,.stats-line,.goal-container{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;align-items:center!important}.writing-stats-wrapper{overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none}.writing-stats-wrapper::-webkit-scrollbar{display:none}.stat-item{flex-shrink:0!important;padding:0 .3rem;font-size:.68rem}.goal-container,.stats-line{flex-shrink:0!important}.zen-mode .writing-stats{bottom:.5rem;right:.5rem;left:.5rem;max-width:none}}.zen-stats-badge{position:fixed;bottom:1rem;right:1rem;background:#000000bf;border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:8px;padding:8px 14px;display:flex;flex-direction:column;gap:4px;z-index:9999;opacity:.8;transition:opacity .2s ease}.zen-stats-badge:hover{opacity:1}.zen-stats-badge .zen-stat-row{display:flex;gap:12px;align-items:center}.zen-stats-badge .zen-stat-label{font-family:IBM Plex Sans,sans-serif!important;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:#ffffff80}.zen-stats-badge .zen-stat-value{font-family:Fraunces,serif!important;font-size:14px;font-weight:600;color:#ffffffe6}

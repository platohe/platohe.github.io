.tags-panel{padding:8px;overflow-y:auto;max-height:100%}.tags-panel h3{margin:0 0 8px;font-size:13px;font-weight:600;color:var(--ms-fg)}.tags-panel-empty{padding:16px;text-align:center;color:var(--ms-fg-muted);font-size:13px}.tags-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}.tag-item{margin:0}.tag-link{display:flex;align-items:center;justify-content:space-between;width:100%;padding:4px 8px;border:none;background:transparent;color:var(--ms-fg);font-size:13px;cursor:pointer;border-radius:4px;text-align:left;transition:background-color .15s}.tag-link:hover{background:var(--ms-bg-elevated)}.tag-link.active{background:var(--ms-accent);color:var(--ms-bg)}.tag-name{font-family:monospace;font-size:12px}.tag-count{font-size:11px;color:var(--ms-fg-muted);background:var(--ms-border);border-radius:10px;padding:1px 6px;min-width:20px;text-align:center}.tag-link.active .tag-count{background:#fff3;color:inherit}.tags-tip code{background:var(--ms-bg-elevated);padding:1px 4px;border-radius:3px;font-size:12px}.tag-clear-btn{margin-top:8px;padding:4px 12px;font-size:12px;background:var(--ms-bg-elevated);border:1px solid var(--ms-border);border-radius:4px;color:var(--ms-fg);cursor:pointer}.tag-clear-btn:hover{background:var(--ms-border)}
/*$vite$:1*/